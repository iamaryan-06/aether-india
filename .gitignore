# ============================================================
# AETHER INDIA — .gitignore
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/
*.egg

# ── Environment Variables (NEVER commit secrets!) ───────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
!backend/.env.example

# ── SQLite Database ──────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── ChromaDB Vector Store (auto-rebuilt on first run) ────────
backend/chroma_db/

# ── Node.js ──────────────────────────────────────────────────
frontend/node_modules/

# ── Next.js Build Output ─────────────────────────────────────
frontend/.next/
frontend/out/

# ── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Archive Files ─────────────────────────────────────────────
*.rar
*.zip
*.tar.gz

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Auto-generated by SETUP.bat (local machine paths) ─────────
.python_path
.node_path
