# ============================================================
# AETHER INDIA — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ── LLM Provider ─────────────────────────────────────────────
# Choose ONE: "openai" | "gemini" | "groq"
LLM_PROVIDER=gemini

# ── OpenAI (if LLM_PROVIDER=openai) ──────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── Google Gemini (if LLM_PROVIDER=gemini) ───────────────────
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash

# ── Groq (if LLM_PROVIDER=groq) ──────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ─────────────────────────────────────────────────
# SQLite file path (relative to backend/ directory)
DATABASE_URL=sqlite:///./aether_store.db

# ── ChromaDB ─────────────────────────────────────────────────
# Local persistent directory for the RAG vector store
CHROMA_PERSIST_DIR=./chroma_db

# ── JWT Authentication ────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key_before_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Application ───────────────────────────────────────────────
APP_NAME=AETHER INDIA
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Refund Threshold (INR) ────────────────────────────────────
# Refunds <= this amount are auto-approved; above requires HITL admin approval
AUTO_REFUND_THRESHOLD_INR=5000
